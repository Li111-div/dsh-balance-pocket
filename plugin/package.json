{
  "name": "dsh-balance-pocket",
  "version": "0.1.0",
  "description": "DSH 渚ф爮搴曢儴浣欓鍏ュ彛锛氬悜涓婂脊鍑哄皬绐楋紝瀹炴椂鏄剧ず DeepSeek 浣欓銆佸嘲璋锋椂娈典笌浠婃棩宸茬敤銆侱SH sidebar balance pocket with a live upward popover for the DeepSeek balance, peak/off-peak pricing and today's spend.",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "Llii-div",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "balance",
    "sidebar",
    "popover",
    "peak-hours"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Llii-div/dsh-balance-pocket.git",
    "directory": "plugin"
  },
  "homepage": "https://github.com/Llii-div/dsh-balance-pocket#readme",
  "bugs": {
    "url": "https://github.com/Llii-div/dsh-balance-pocket/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./peak": "./peak.js",
    "./ledger": "./ledger.js",
    "./holidays": "./holidays.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "peak.js",
    "ledger.js",
    "holidays.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
